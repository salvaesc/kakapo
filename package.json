{
  "name": "kakapo",
  "version": "0.1.0",
  "private": true,
  "description": "KAKAPO \u2014 a voice-controlled pixel-art platformer (vanilla JS, no dependencies)",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "python3 tests/e2e.py",
    "build:www": "python3 tools/build-single.py www/index.html",
    "android:sync": "npm run build:www && npx cap sync android"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9"
  }
}
